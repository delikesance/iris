{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "dialog:default",
    "notification:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "mailto:*"
        }
      ]
    },
    "opener:allow-reveal-item-in-dir"
  ]
}